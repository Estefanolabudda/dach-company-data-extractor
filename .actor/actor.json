{
  "actorSpecification": 1,
  "name": "dach-company-data-extractor",
  "title": "DACH Company Data Extractor – Impressum + VIES",
  "description": "Turn any German, Austrian or Swiss website into a structured company record: legal name, legal form, address, register court/number, VAT ID (validated via EU VIES), representatives, contact data. Input: list of URLs.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "../Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Company records",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": ["domain", "companyName", "legalForm", "street", "postalCode", "city", "country", "registerType", "registerNumber", "registerCourt", "vatId", "vies", "email", "phone", "representatives", "confidence", "impressumUrl", "errors"]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": { "label": "Domain", "format": "text" },
              "companyName": { "label": "Company", "format": "text" },
              "legalForm": { "label": "Legal form", "format": "text" },
              "city": { "label": "City", "format": "text" },
              "country": { "label": "Country", "format": "text" },
              "vatId": { "label": "VAT ID", "format": "text" },
              "registerNumber": { "label": "Register no.", "format": "text" },
              "email": { "label": "E-mail", "format": "text" },
              "confidence": { "label": "Confidence", "format": "number" },
              "impressumUrl": { "label": "Source", "format": "link" }
            }
          }
        }
      }
    }
  }
}
